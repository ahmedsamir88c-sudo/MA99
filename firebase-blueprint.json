{
  "entities": {
    "User": {
      "title": "User",
      "description": "Student or Administrator user profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "username": { "type": "string", "maxLength": 64 },
        "fullName": { "type": "string", "maxLength": 128 },
        "universityId": { "type": "string", "maxLength": 32 },
        "academicYear": { "type": "number" },
        "role": { "type": "string", "enum": ["student", "owner", "admin"] },
        "xp": { "type": "number" },
        "streak": { "type": "number" },
        "profileImage": { "type": "string", "maxLength": 500000 },
        "isActive": { "type": "boolean" },
        "authProvider": { "type": "string", "enum": ["local", "google"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "username", "universityId", "academicYear", "role"]
    },
    "QuizAttempt": {
      "title": "QuizAttempt",
      "description": "Record of a completed quiz session",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "quizId": { "type": "string", "maxLength": 128 },
        "subject": { "type": "string", "maxLength": 128 },
        "lecture": { "type": "number" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "earnedXp": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "quizId", "score", "totalQuestions", "earnedXp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles indexed by UID"
    },
    "/quizAttempts/{attemptId}": {
      "schema": "QuizAttempt",
      "description": "User quiz attempts"
    }
  }
}
